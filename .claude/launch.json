{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "http.server", "4173", "--bind", "127.0.0.1", "--directory", "site"],
      "port": 4173
    },
    {
      "name": "live",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "truelift.api:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    }
  ]
}
