{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YashG1836/truelift/blob/main/docs/events/offer.quoted.schema.json",
  "title": "Offer quoted",
  "description": "TrueLift's forecast for an offer being set up, before the OTP screen. Wrapped in a CloudEvents 1.0 envelope so it fits an existing event bus.",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "description": "Unique per event; consumers drop duplicates by it"
    },
    "source": {
      "type": "string",
      "description": "The service that wrote it, e.g. /truelift/serve"
    },
    "type": {
      "const": "truelift.offer.quoted"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "data": {
      "type": "object",
      "required": [
        "draft_id",
        "restaurant_id",
        "design",
        "profit_change",
        "profit_low",
        "profit_high",
        "model_version"
      ],
      "properties": {
        "draft_id": {
          "type": "string"
        },
        "restaurant_id": {
          "type": "integer"
        },
        "design": {
          "type": "object",
          "description": "The offer as the owner set it up (the API's design fields)",
          "required": [
            "discount",
            "min_order",
            "audience",
            "offpeak_only",
            "reward",
            "zomato_share",
            "pct"
          ],
          "properties": {
            "discount": {
              "type": "number",
              "minimum": 0,
              "description": "Rupees off; for a percentage offer the cap"
            },
            "pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.6,
              "description": "Share of the bill off; 0 = flat"
            },
            "min_order": {
              "type": "number",
              "minimum": 0
            },
            "audience": {
              "enum": [
                "all",
                "new_to_restaurant",
                "lapsed",
                "targeted"
              ]
            },
            "offpeak_only": {
              "type": "boolean"
            },
            "reward": {
              "type": "number",
              "minimum": 0,
              "description": "Brand Pack reward per order for regulars"
            },
            "zomato_share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "profit_change": {
          "type": "number",
          "description": "Expected change in weekly profit, rupees"
        },
        "profit_low": {
          "type": "number"
        },
        "profit_high": {
          "type": "number"
        },
        "extra_orders": {
          "type": "number"
        },
        "suggested_design": {
          "type": "object",
          "description": "A better version at the same discount, if any",
          "required": [
            "discount",
            "min_order",
            "audience",
            "offpeak_only",
            "reward",
            "zomato_share",
            "pct"
          ],
          "properties": {
            "discount": {
              "type": "number",
              "minimum": 0,
              "description": "Rupees off; for a percentage offer the cap"
            },
            "pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.6,
              "description": "Share of the bill off; 0 = flat"
            },
            "min_order": {
              "type": "number",
              "minimum": 0
            },
            "audience": {
              "enum": [
                "all",
                "new_to_restaurant",
                "lapsed",
                "targeted"
              ]
            },
            "offpeak_only": {
              "type": "boolean"
            },
            "reward": {
              "type": "number",
              "minimum": 0,
              "description": "Brand Pack reward per order for regulars"
            },
            "zomato_share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "model_version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
